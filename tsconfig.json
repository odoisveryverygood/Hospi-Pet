{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src", "tests", "*.config.ts"]
}
